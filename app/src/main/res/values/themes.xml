<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Daybook" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFBF2</item>
        <item name="android:statusBarColor">#FFFBF2</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Shown by Android while the app starts, then hands over to the animated splash. -->
    <style name="Theme.Daybook.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2F4B7C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Daybook</item>
    </style>
</resources>
